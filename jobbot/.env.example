# Copy to .env and fill in. At least one job-board key is required.

# Reed Jobseeker API — free, instant: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Adzuna API — free: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed account credentials — only needed if apply.enabled=true (auto-apply).
# Complete your Reed profile + upload your CV on the site first.
REED_EMAIL=
REED_PASSWORD=

# Telegram instant alerts — create a bot with @BotFather, then message it once
# and get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
