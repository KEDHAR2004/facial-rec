{
  "name": "facial-rec",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "web",
      "description": "facial-rec Flask web UI served by gunicorn on port 5000",
      "command": "./.venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 --access-logfile - app:app"
    }
  ],
  "ports": [
    {
      "name": "facial-rec web",
      "port": 5000
    }
  ]
}
